{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "*.ts"]
}
