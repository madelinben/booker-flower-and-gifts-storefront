{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booker-flowers-storefront",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    { "binding": "DB", "database_name": "booker-orders", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "booker-delivery-photos" }]
}
